# Copy to .env and fill in. .env is gitignored.

# Required — get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# ── optional: resource profile ────────────────────────────────────────────────────────
# auto (default) picks the best profile that leaves VRAM headroom. Force one with:
#   quality  bge-m3 + bge-reranker-v2-m3   ~3324 MiB VRAM
#   balanced bge-m3 + bge-reranker-base    ~2690 MiB VRAM   <- default on a 4 GB card
#   lean     bge-m3 local, reranking on NIM ~1930 MiB VRAM
#   cpu      no GPU at all (slow)
# KYR_PROFILE=auto
# KYR_VRAM_RESERVE_MB=1024      # VRAM deliberately left free for the rest of your desktop
# KYR_RAM_FLOOR_MB=1200         # refuse to load models below this much free RAM
# KYR_MODEL_IDLE_EVICT_S=900    # free the models after this long idle (0 = never)

# ── optional: models ──────────────────────────────────────────────────────────────────
# KYR_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
# KYR_WRITER_MODEL=nvidia/nemotron-3-super-120b-a12b
# KYR_FAST_RPM=30               # per-model budget; NVIDIA's free tier is ~40/min PER MODEL
# KYR_WRITER_RPM=25
# KYR_SESSION_CREDIT_BUDGET=0   # >0 makes the agent downshift depth as credits run low

# ── optional: research behaviour ──────────────────────────────────────────────────────
# KYR_DEFAULT_DEPTH=auto
# KYR_TOP_K=5
# KYR_CRAWL_USE_BROWSER=true    # false = HTTP only, saves ~400 MB RSS, misses JS-only sites
# KYR_CRAWL_RESPECT_ROBOTS=true

# ── optional: a keyed web-search provider (DuckDuckGo is used when both are absent) ────
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── optional: server ──────────────────────────────────────────────────────────────────
# KYR_HOST=127.0.0.1
# KYR_PORT=8000
# KYR_LOG_LEVEL=INFO

# Copy to .env and fill in. .env is gitignored.

# ── keys ──────────────────────────────────────────────────────────────────────────────
# OpenRouter is the primary provider: it serves the chat models AND the retrieval models
# (bge-m3 embeddings, Cohere reranking). https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional, free: a second provider with its own independent rate limits, used as failover.
# https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# ── retrieval profile ─────────────────────────────────────────────────────────────────
#   api       embedding + reranking over OpenRouter. No local weights, ~0 GB RAM, ~660 ms a
#             search. Recall@5 100%, MRR 0.881 on the gold set. <- recommended
#   balanced  bge-m3 + bge-reranker-base on a GPU. Recall@5 100%, ~400 ms, ~2.7 GB VRAM.
#   cpu       both models on CPU. Recall@5 95.2% at pool 8, but ~6.6 s a search on one core.
#   cpu_lean  local embedder, no reranker. Fast, but weak at refusing off-topic questions.
#   lite      BM25 only, no models, under 1 GB. Recall@5 90.5%.
#   auto      pick the best local profile that fits (does not choose `api` unless told to).
KYR_PROFILE=api

# Retrieval is the only part billed per call. Past this many dollars in one process, ranking
# degrades to fused RRF scores rather than spending more. 0 = no ceiling.
# KYR_RETRIEVAL_API_BUDGET_USD=2.0
# KYR_RERANK_API_MODEL=cohere/rerank-v3.5     # or qwen/qwen3-reranker-8b: 3.6x cheaper, slower

# ── models (the defaults are measured — see scripts/race_openrouter.py) ────────────────
# fast stages: google/gemini-2.5-flash-lite -> inception/mercury-2.5 -> nemotron-nano (paid)
#              -> NVIDIA NIM failover
# writer:      nemotron-3-super-120b:free -> qwen3.7-flash -> gemini-2.5-flash-lite -> NIM
# Force one for an experiment, as "provider:model-id":
# KYR_FAST_MODEL=openrouter:google/gemini-2.5-flash-lite
# KYR_WRITER_MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_RPM=15             # free models: ~20/min SHARED across all of them
# OPENROUTER_PAID_RPM=60        # paid models are metered in money, not by that limit
# OPENROUTER_DAILY_LIMIT=1000   # the free-model daily allowance; paid calls do not count

# ── research behaviour ────────────────────────────────────────────────────────────────
# KYR_DEFAULT_DEPTH=auto
# KYR_TOP_K=5
# KYR_CRAWL_USE_BROWSER=true    # false = HTTP only, saves ~400 MB RSS, misses JS-only sites
# KYR_CRAWL_RESPECT_ROBOTS=true

# ── a keyed web-search provider (DuckDuckGo is used when both are absent) ─────────────
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── server ────────────────────────────────────────────────────────────────────────────
# KYR_HOST=127.0.0.1
# KYR_PORT=8000
# KYR_LOG_LEVEL=INFO

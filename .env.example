# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Real environment variables take precedence over this file.

# ── required ──────────────────────────────────────────────────────────────────────────
# OpenRouter serves the chat models and the retrieval models (bge-m3 embeddings, Cohere
# reranking). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── optional providers ────────────────────────────────────────────────────────────────
# NVIDIA NIM: a free second chat provider with its own rate limits, used only as failover.
# https://build.nvidia.com
# NVIDIA_API_KEY=
# A keyed web-search provider; without one, keyless DuckDuckGo/Yahoo/Yandex search is used.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# ── public deployment guards ──────────────────────────────────────────────────────────
# Answers researched at once; later questions queue and are shown their place in line.
# KYR_MAX_ACTIVE_TURNS=5
# KYR_MAX_QUEUED_TURNS=20
# KYR_QUEUE_TIMEOUT_S=180
# Dollars each client (IP address) may spend; the window is when it resets (0 = never).
# KYR_CLIENT_BUDGET_USD=1.0
# KYR_CLIENT_BUDGET_WINDOW_H=0
# Questions per minute, and questions in progress or waiting, per client.
# KYR_CLIENT_RPM=10
# KYR_CLIENT_MAX_PENDING=2
# A ceiling on the whole service's spend per UTC day (0 = no ceiling).
# KYR_DAILY_BUDGET_USD=5.0
# Set to true ONLY behind a reverse proxy or tunnel, so the real client address is used.
# KYR_TRUST_PROXY_HEADERS=false
# Bearer token for /api/status. Without one, that endpoint answers only from this machine.
# KYR_ADMIN_TOKEN=

# ── server ────────────────────────────────────────────────────────────────────────────
# KYR_HOST=127.0.0.1
# KYR_PORT=8000
# KYR_LOG_LEVEL=INFO

# ── models (defaults are measured: scripts/race_models.py) ────────────────────────────
# Force one model for an experiment, as "provider:model-id".
# KYR_FAST_MODEL=openrouter:google/gemini-2.5-flash-lite
# KYR_WRITER_MODEL=openrouter:qwen/qwen3.7-flash
# The reranker; a different one needs `python scripts/calibrate.py`.
# KYR_RERANK_API_MODEL=cohere/rerank-v3.5

# ── research behaviour ────────────────────────────────────────────────────────────────
# KYR_TOP_K=5
# KYR_CRAWL_USE_BROWSER=true      # false: plain HTTP only, less memory, misses JS-only pages
# KYR_CRAWL_RESPECT_ROBOTS=true

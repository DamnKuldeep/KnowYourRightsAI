# Secrets
.env
.env.*
!.env.example
*.pem
*.ppk
*.key
kyr-key*

# Runtime state: caches, usage log, local calibrations, client spend, feedback
.runtime/

# LanceDB writes transient bookkeeping here. _deletions/ is NOT transient: the table manifest
# names its deletion files, so a clone without them cannot open the database.
data/legal_db/**/_transactions/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Crawl4AI's own cache
.crawl4ai/

# Logs
*.log

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
